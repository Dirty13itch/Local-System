# ============================================================
# Local-System — Sovereign AI Platform
# Environment Configuration
# ============================================================
# Copy to .env and edit for your deployment.
# IPs are populated after Phase 0.1 auto-discovery.
# Run: scripts/discover.sh → docs/infrastructure-report.md
# ============================================================

# --- Node Identity ---
NODE_NAME=dev                      # FOUNDRY, WORKSHOP, VAULT, DEV, DESK, MOBILE
NODE_ROLE=operations               # inference, creative, orchestrator, operations, client

# --- Node Addresses (populated by Phase 0.1 discovery) ---
FOUNDRY_HOST=changeme              # Heavy inference, agents, vector DB
WORKSHOP_HOST=changeme             # Fast inference, creative, dashboard
VAULT_HOST=changeme                # Storage, routing, monitoring, HA, media
DEV_HOST=127.0.0.1                 # Operations center (local)

# --- Core Service Ports ---
GATEWAY_PORT=8700                  # API gateway (REST/SSE/WS)
MEMORY_PORT=8702                   # Memory service
ORCHESTRATOR_PORT=8703             # Agent lifecycle management
AGENT_SERVER_PORT=9000             # LangGraph agent server
GPU_ORCHESTRATOR_PORT=9200         # GPU sleep/wake orchestrator
UI_PORT=3001                       # Command Center web UI

# --- Inference Stack ---
# LiteLLM (API Gateway — routes to vLLM instances)
LITELLM_HOST=http://${VAULT_HOST}:4000
LITELLM_KEY=changeme

# vLLM instances (ports/IPs set after GPU discovery)
# VLLM_REASONING_HOST=http://${FOUNDRY_HOST}:8000
# VLLM_FAST_HOST=http://${WORKSHOP_HOST}:8000
# VLLM_EMBEDDING_HOST=http://${FOUNDRY_HOST}:8001

# --- Databases (on VAULT) ---
# Redis 8
REDIS_HOST=${VAULT_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Qdrant v1.17 (Vector DB)
QDRANT_HOST=${VAULT_HOST}
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Neo4j (Knowledge Graph)
NEO4J_HOST=${VAULT_HOST}
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# PostgreSQL (for LiteLLM logging)
POSTGRES_HOST=${VAULT_HOST}
POSTGRES_PORT=5432
POSTGRES_DB=local_system
POSTGRES_USER=local_system
POSTGRES_PASSWORD=changeme

# --- RAG / Embeddings ---
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Model Storage ---
MODEL_DIR=/mnt/vault/models        # NFS mount from VAULT

# --- Creative Pipeline ---
COMFYUI_HOST=http://${WORKSHOP_HOST}:8188

# --- Voice Pipeline ---
WHISPER_HOST=http://${FOUNDRY_HOST}:10300
PIPER_HOST=http://${VAULT_HOST}:10200

# --- Home Automation ---
HOMEASSISTANT_HOST=http://${VAULT_HOST}:8123
HOMEASSISTANT_TOKEN=changeme

# --- Monitoring ---
PROMETHEUS_HOST=${VAULT_HOST}
PROMETHEUS_PORT=9090
GRAFANA_HOST=${VAULT_HOST}
GRAFANA_PORT=3003

# --- Letta (Agent Memory) ---
LETTA_HOST=http://${FOUNDRY_HOST}:8283
LETTA_PASSWORD=changeme

# --- Auth ---
API_SECRET_KEY=changeme-generate-a-real-secret

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
