# =============================================================================
# Local-System v4 — Sovereign AI Platform
# Environment Configuration
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- Node Identity ---
NODE_NAME=dev
NODE_ROLE=operations

# --- Cluster Network ---
FOUNDRY_HOST=192.168.1.244
WORKSHOP_HOST=192.168.1.225
VAULT_HOST=192.168.1.203
DEV_HOST=192.168.1.189

# --- Core Service Ports ---
GATEWAY_PORT=8700
MIND_PORT=8710
MEMORY_PORT=8720
PERCEPTION_PORT=8730
UI_PORT=3001

# --- Inference Stack ---
# LiteLLM (API Gateway — routes to vLLM instances)
LITELLM_HOST=http://192.168.1.203:4000
LITELLM_MASTER_KEY=sk-CHANGE-ME-your-litellm-master-key

# vLLM instances — FOUNDRY
VLLM_REASONING_HOST=http://192.168.1.244:8000
VLLM_CODING_HOST=http://192.168.1.244:8002
VLLM_CREATIVE_HOST=http://192.168.1.244:8004

# vLLM instances — WORKSHOP
VLLM_FAST_HOST=http://192.168.1.225:8000

# vLLM instances — DEV (embedding + reranker)
VLLM_EMBEDDING_HOST=http://192.168.1.189:8001
VLLM_RERANKER_HOST=http://192.168.1.189:8003

# RAG / Embeddings
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Cloud API Keys (for LiteLLM fallback routing) ---
# Populate these on VAULT .env for cloud model routing
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- PostgreSQL (VAULT) ---
POSTGRES_HOST=192.168.1.203
POSTGRES_PORT=5432
POSTGRES_DB=local_system
POSTGRES_USER=local_system
POSTGRES_PASSWORD=CHANGE-ME-generate-strong-password

# --- Redis (VAULT) ---
REDIS_HOST=192.168.1.203
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE-ME-generate-strong-password

# --- Qdrant (VAULT) ---
QDRANT_HOST=192.168.1.203
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Neo4j (VAULT) ---
NEO4J_HOST=192.168.1.203
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE-ME-your-neo4j-password

# --- Meilisearch (VAULT) ---
MEILISEARCH_HOST=192.168.1.203
MEILISEARCH_PORT=7700
MEILISEARCH_KEY=CHANGE-ME-your-meilisearch-key

# --- Creative Pipeline ---
COMFYUI_URL=http://192.168.1.225:8188

# --- Model Storage ---
MODEL_DIR=/mnt/vault/models

# --- Monitoring ---
PROMETHEUS_HOST=192.168.1.203
PROMETHEUS_PORT=9090
GRAFANA_HOST=192.168.1.203
GRAFANA_PORT=3000

# --- Notifications ---
NTFY_HOST=http://192.168.1.203:8880

# --- Auth ---
API_SECRET_KEY=CHANGE-ME-generate-random-key

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
