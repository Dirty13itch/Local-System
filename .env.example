# ============================================================
# Athanor — Sovereign Cognitive Architecture
# Environment Configuration
# ============================================================
# Copy to .env and edit for your deployment
# ============================================================

# --- Node Identity ---
NODE_NAME=hydra-storage            # hydra-ai, hydra-compute, hydra-storage, hydra-dev, desk, mobile
NODE_ROLE=orchestrator             # inference, compute, orchestrator, dev, client

# --- Node Addresses (Actual Network) ---
HYDRA_AI_HOST=192.168.1.250        # TR 7960X, 5090+4090, NixOS
HYDRA_COMPUTE_HOST=192.168.1.203   # R9 9950X, 2x5070Ti, NixOS
HYDRA_STORAGE_HOST=192.168.1.244   # EPYC 7663, Unraid, orchestration brain
HYDRA_STORAGE_IPMI=192.168.1.216   # IPMI for remote management

# --- Core Service Ports ---
GATEWAY_PORT=8700                  # API gateway (REST/SSE/WS)
COGNITIVE_PORT=8701                # GWT cognitive workspace
MEMORY_PORT=8702                   # 6-tier memory service
ORCHESTRATOR_PORT=8703             # Agent lifecycle management
UI_PORT=3200                       # Command Center web UI

# --- Inference Stack ---
# LiteLLM (API Gateway — routes to all backends)
LITELLM_HOST=http://192.168.1.244:4000
LITELLM_KEY=changeme

# TabbyAPI + ExLlamaV2 (Primary — 70B models, tensor parallel 5090+4090)
TABBY_HOST=http://192.168.1.250:5000
TABBY_MODEL_DIR=/mnt/models/exl2
TABBY_GPU_SPLIT=auto               # or "32,24" for manual 5090+4090 split
TABBY_MAX_SEQ_LEN=32768
TABBY_CACHE_MODE=FP16

# Ollama GPU (Secondary — 7B-14B fast models on 5070 Ti)
OLLAMA_GPU_HOST=http://192.168.1.203:11434

# Ollama CPU (Fallback — on EPYC 56-core)
OLLAMA_CPU_HOST=http://192.168.1.244:11434

# --- Databases (all on hydra-storage) ---
# PostgreSQL 16
POSTGRES_HOST=192.168.1.244
POSTGRES_PORT=5432
POSTGRES_DB=athanor
POSTGRES_USER=hydra
POSTGRES_PASSWORD=changeme

# Redis 7
REDIS_HOST=192.168.1.244
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Qdrant (Vector DB)
QDRANT_HOST=192.168.1.244
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Neo4j (Knowledge Graph)
NEO4J_HOST=192.168.1.244
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Meilisearch (Full-text BM25)
MEILISEARCH_HOST=192.168.1.244
MEILISEARCH_PORT=7700
MEILISEARCH_KEY=changeme

# MinIO (S3-compatible storage)
MINIO_HOST=192.168.1.244
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=hydra
MINIO_PASSWORD=changeme

# --- RAG / Embeddings ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=512
CHUNK_OVERLAP=64
HYBRID_SEARCH_ALPHA=0.7            # 0.7 = 70% vector, 30% BM25

# --- Model Storage ---
MODEL_DIR=/mnt/models               # NFS mount from hydra-storage
MODEL_EXL2_DIR=/mnt/models/exl2     # ExLlamaV2 quantized models
MODEL_GGUF_DIR=/mnt/models/gguf     # llama.cpp format
MODEL_EMBEDDINGS_DIR=/mnt/models/embeddings
MODEL_DIFFUSION_DIR=/mnt/models/diffusion

# --- Creative Pipeline ---
COMFYUI_HOST=http://192.168.1.203:8188
KOKORO_TTS_HOST=http://192.168.1.244:8880

# --- Home Automation ---
HOMEASSISTANT_HOST=http://192.168.1.244:8123
HOMEASSISTANT_TOKEN=changeme

# --- Monitoring ---
PROMETHEUS_HOST=192.168.1.244
PROMETHEUS_PORT=9090
GRAFANA_HOST=192.168.1.244
GRAFANA_PORT=3003
UPTIME_KUMA_HOST=192.168.1.244
UPTIME_KUMA_PORT=3004

# --- Automation ---
N8N_HOST=http://192.168.1.244:5678

# --- Auth ---
API_SECRET_KEY=changeme-generate-a-real-secret

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
