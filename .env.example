# ============================================================
# Local-System Environment Configuration
# ============================================================
# Copy to .env and edit for your node
# ============================================================

# --- Node Identity ---
NODE_NAME=desk                  # node1, node2, vault, desk, dev, mobile
NODE_ROLE=orchestrator          # inference, storage, orchestrator, dev, client

# --- Network ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8001
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8002
RAG_HOST=0.0.0.0
RAG_PORT=8003
STORAGE_HOST=0.0.0.0
STORAGE_PORT=8004
MODEL_MANAGER_HOST=0.0.0.0
MODEL_MANAGER_PORT=8005
UI_PORT=3000

# gRPC ports (internal)
INFERENCE_GRPC_PORT=50051
ORCHESTRATOR_GRPC_PORT=50052
RAG_GRPC_PORT=50053
STORAGE_GRPC_PORT=50054
MODEL_MANAGER_GRPC_PORT=50055

# --- Node Addresses (10GbE) ---
# Set these to the 10GbE IPs of each node
NODE1_HOST=10.0.0.11
NODE2_HOST=10.0.0.12
VAULT_HOST=10.0.0.13
DESK_HOST=10.0.0.14
DEV_HOST=10.0.0.15
MOBILE_HOST=10.0.0.16

# --- Database (VAULT) ---
POSTGRES_HOST=${VAULT_HOST}
POSTGRES_PORT=5432
POSTGRES_DB=local_system
POSTGRES_USER=local_system
POSTGRES_PASSWORD=changeme

# --- Redis (DESK) ---
REDIS_HOST=${DESK_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# --- Vector DB (VAULT) ---
QDRANT_HOST=${VAULT_HOST}
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Inference Backends ---
# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_PARALLEL=4

# vLLM
VLLM_HOST=http://localhost:8100
VLLM_TENSOR_PARALLEL_SIZE=4
VLLM_GPU_MEMORY_UTILIZATION=0.90

# llama.cpp
LLAMACPP_HOST=http://localhost:8200
LLAMACPP_N_GPU_LAYERS=-1

# --- Model Storage ---
MODEL_CACHE_DIR=/models
MODEL_REGISTRY_URL=http://${VAULT_HOST}:${STORAGE_PORT}/models

# --- Storage ---
STORAGE_DATA_DIR=/data
STORAGE_HDD_MOUNT=/mnt/hdd-array
STORAGE_UPLOAD_MAX_SIZE=10737418240  # 10GB

# --- RAG ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Auth ---
API_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
ENABLE_METRICS=true
